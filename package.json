{
  "name": "my-aws",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AWS learning dashboard for tags and S3 object previews.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace @my-aws/api",
    "dev:web": "npm run dev --workspace @my-aws/web",
    "build": "npm run build --workspaces --if-present",
    "check:esm": "node scripts/check-esm.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "@swc/core@1.15.41": true
  }
}
