AWS_REGION=eu-north-1
AWS_PROFILE=default
# Explicit web origins. The API also allows http://localhost:517* for Vite dev ports.
WEB_ORIGIN=http://localhost:5173

# not all services are supported by the app, see packages/shared/src/app-config.ts for supported services
# these services must be included in the list of supported services
MY_AWS_ENABLED_SERVICE_LOOKUPS=iam,s3,ecr,ssm
MY_AWS_S3_MAX_OBJECTS_PER_BUCKET=200
MY_AWS_S3_PREVIEW_EXTENSIONS=.html,.tf
MY_AWS_S3_MAX_PREVIEW_BYTES=1000000

# Optional frontend-only privacy mode. When true, rendered 12-digit
# AWS account ids are shown as ***** while API requests still use real values.
VITE_MY_AWS_MASK_ACCOUNT_IDS=false
