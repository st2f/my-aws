    "@swc/core": "^1.15.41",
    "@types/node": "^24.0.10",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
